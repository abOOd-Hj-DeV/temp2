APP_NAME=Sakina
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL per the Sakina backend plan
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sakina
DB_USERNAME=postgres
DB_PASSWORD=

# API-only app: no cookie sessions needed
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Realtime chat: set to "reverb" in production and provide the keys below
# (generate random values; the same key/secret go to the mobile client).
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local

# Redis per the Sakina backend plan (queues + cache/OTP store)
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# UltraMsg WhatsApp gateway (OTP + critical alerts)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_BASE_URL=https://api.ultramsg.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sakina platform
SAKINA_SESSION_PRICE=50.00
SAKINA_SESSION_DURATION_MINUTES=60
SAKINA_SUB_4W_PRICE=150.00
SAKINA_SUB_8W_PRICE=260.00
UPLOADS_DISK=s3
